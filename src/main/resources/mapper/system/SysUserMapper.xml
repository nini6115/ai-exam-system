<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiexam.system.mapper.SysUserMapper">

    <!-- 用户基本字段 -->
    <resultMap id="BaseResultMap" type="com.aiexam.system.entity.SysUser">
        <id     column="id"              property="id"/>
        <result column="username"        property="username"/>
        <result column="password"        property="password"/>
        <result column="real_name"       property="realName"/>
        <result column="user_no"         property="userNo"/>
        <result column="gender"          property="gender"/>
        <result column="phone"           property="phone"/>
        <result column="email"           property="email"/>
        <result column="avatar"          property="avatar"/>
        <result column="status"          property="status"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="last_login_ip"   property="lastLoginIp"/>
        <result column="create_time"     property="createTime"/>
        <result column="update_time"     property="updateTime"/>
        <result column="deleted"         property="deleted"/>
    </resultMap>

    <!-- 用户 + 角色列表 -->
    <resultMap id="UserWithRolesMap" type="com.aiexam.system.entity.SysUser" extends="BaseResultMap">
        <collection property="roles" ofType="com.aiexam.system.entity.SysRole" javaType="java.util.List">
            <id     column="role_id"          property="id"/>
            <result column="role_code"        property="roleCode"/>
            <result column="role_name"        property="roleName"/>
            <result column="role_description" property="description"/>
            <result column="role_create_time" property="createTime"/>
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        u.id, u.username, u.password, u.real_name, u.user_no, u.gender,
        u.phone, u.email, u.avatar, u.status, u.last_login_time, u.last_login_ip,
        u.create_time, u.update_time, u.deleted
    </sql>

    <sql id="Role_Column_List">
        r.id          AS role_id,
        r.role_code   AS role_code,
        r.role_name   AS role_name,
        r.description AS role_description,
        r.create_time AS role_create_time
    </sql>

    <!-- 根据用户名查用户（含角色） -->
    <select id="selectByUsername" resultMap="UserWithRolesMap">
        SELECT
            <include refid="Base_Column_List"/>,
            <include refid="Role_Column_List"/>
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON ur.user_id = u.id
        LEFT JOIN sys_role r       ON r.id = ur.role_id
        WHERE u.username = #{username}
          AND u.deleted = 0
    </select>

    <!-- 根据ID查用户 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM sys_user u
        WHERE u.id = #{id}
          AND u.deleted = 0
    </select>

    <!-- 分页查询用户列表（多条件动态 SQL；角色单独批量查，避免联表导致 total 统计翻倍） -->
    <select id="selectUserPage" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM sys_user u
        WHERE u.deleted = 0
        <if test="q.username != null and q.username != ''">
            AND u.username LIKE CONCAT('%', #{q.username}, '%')
        </if>
        <if test="q.realName != null and q.realName != ''">
            AND u.real_name LIKE CONCAT('%', #{q.realName}, '%')
        </if>
        <if test="q.status != null">
            AND u.status = #{q.status}
        </if>
        <if test="q.roleCode != null and q.roleCode != ''">
            AND EXISTS (
                SELECT 1
                FROM sys_user_role ur2
                INNER JOIN sys_role r2 ON r2.id = ur2.role_id
                WHERE ur2.user_id = u.id AND r2.role_code = #{q.roleCode}
            )
        </if>
        ORDER BY u.id DESC
    </select>

    <!-- 批量插入用户角色关联 -->
    <insert id="insertUserRoles">
        INSERT INTO sys_user_role (user_id, role_id) VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId})
        </foreach>
    </insert>

    <!-- 删除用户所有角色关联 -->
    <delete id="deleteUserRoles">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>

    <!-- 更新登录信息 -->
    <update id="updateLoginInfo">
        UPDATE sys_user
        SET last_login_time = #{lastLoginTime},
            last_login_ip   = #{lastLoginIp}
        WHERE id = #{id}
    </update>

</mapper>
