<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiexam.system.mapper.SysRoleMapper">

    <resultMap id="BaseResultMap" type="com.aiexam.system.entity.SysRole">
        <id     column="id"          property="id"/>
        <result column="role_code"   property="roleCode"/>
        <result column="role_name"   property="roleName"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 根据用户ID查角色列表 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT r.id, r.role_code, r.role_name, r.description, r.create_time
        FROM sys_role r
        INNER JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
    </select>

    <!-- 角色带所属用户ID -->
    <resultMap id="UserRoleMap" type="com.aiexam.system.entity.SysRole" extends="BaseResultMap">
        <result column="user_id" property="userId"/>
    </resultMap>

    <!-- 根据用户ID列表批量查角色（携带 userId） -->
    <select id="selectByUserIds" resultMap="UserRoleMap">
        SELECT ur.user_id, r.id, r.role_code, r.role_name, r.description, r.create_time
        FROM sys_role r
        INNER JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>

</mapper>
