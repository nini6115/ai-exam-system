<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiexam.exam.mapper.ExamMapper">

    <resultMap id="ExamVOResult" type="com.aiexam.exam.vo.ExamVO">
        <id     property="id"               column="id"/>
        <result property="name"             column="name"/>
        <result property="paperId"           column="paper_id"/>
        <result property="paperName"        column="paper_name"/>
        <result property="startTime"        column="start_time"/>
        <result property="endTime"          column="end_time"/>
        <result property="duration"         column="duration"/>
        <result property="status"           column="status"/>
        <result property="maxAttempts"       column="max_attempts"/>
        <result property="randomOrder"      column="random_order"/>
        <result property="maxScreenSwitch"  column="max_screen_switch"/>
        <result property="studentCount"     column="student_count"/>
        <result property="createTime"       column="create_time"/>
    </resultMap>

    <!-- 考试分页列表：join 试卷取名、子查询统计考生数、按当前时间实时推导状态 -->
    <select id="selectExamPage" resultMap="ExamVOResult">
        SELECT e.id,
               e.name,
               e.paper_id,
               p.name           AS paper_name,
               e.start_time,
               e.end_time,
               e.duration,
               CASE WHEN NOW() &lt; e.start_time THEN 1
                    WHEN NOW() &lt;= e.end_time  THEN 2
                    ELSE 3 END  AS status,
               e.max_attempts,
               e.random_order,
               e.max_screen_switch,
               (SELECT COUNT(*) FROM exam_user eu WHERE eu.exam_id = e.id) AS student_count,
               e.create_time
        FROM exam e
        LEFT JOIN exam_paper p ON p.id = e.paper_id
        <where>
            <if test="name != null and name != ''">
                AND e.name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY e.id DESC
    </select>
</mapper>
